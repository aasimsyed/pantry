# Optional: copy to .env and set values
# iOS (set by run-e2e-ios.sh or manually)
# IOS_UDID=
# IOS_DEVICE_NAME=
# IOS_PLATFORM_VERSION=
#
# Full E2E: backend the app uses (same as EXPO_PUBLIC_API_URL when testing locally)
# E2E_API_URL=http://localhost:8000
#
# E2E user (reused across all future runs). Defaults in code if unset:
# E2E_EMAIL=e2e@test.smartpantry.local
# E2E_PASSWORD=E2eTest-Reuse-Password1
