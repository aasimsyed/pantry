{
  "name": "smart-pantry-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Appium E2E tests for Smart Pantry mobile app",
  "scripts": {
    "postinstall": "node scripts/postinstall-patch-unicorn-magic.js",
    "e2e": "wdio run wdio.conf.ts",
    "e2e:ios": "./scripts/run-e2e-ios.sh",
    "e2e:ios:device": "./scripts/run-e2e-ios.sh --device",
    "e2e:ios:simulator": "./scripts/run-e2e-ios.sh --simulator",
    "e2e:ios:skip-build": "./scripts/run-e2e-ios.sh --skip-build",
    "e2e:smoke": "wdio run wdio.conf.cjs --spec specs/smoke.e2e.ts",
    "e2e:a11y": "wdio run wdio.a11y.conf.cjs",
    "e2e:full": "wdio run wdio.full.conf.cjs",
    "install:axe-driver": "appium driver install --source=npm @axe-devtools/axe-appium-xcuitest-driver"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.23.2",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^6.7.15",
    "appium-xcuitest-driver": "^10.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "webdriverio": "^9.4.0"
  }
}
