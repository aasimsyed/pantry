# Copy to .env and fill in. For EAS/TestFlight, set these in EAS Secrets instead.
# Sentry DSN (get from Sentry → Project Settings → Client Keys). Leave empty to disable crash reporting.
EXPO_PUBLIC_SENTRY_DSN=
# RevenueCat iOS public SDK key (appl_...). Leave empty to hide subscriptions.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
