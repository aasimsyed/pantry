# Copy to .env.build and fill in your values.
# .env.build is git-ignored; never commit your credentials.

# Required: Apple Developer Team ID
APPLE_TEAM_ID=K5A25879TB

# TestFlight upload — choose one option:

# Option A: App Store Connect API Key (recommended for automation)
# Create at: App Store Connect → Users and Access → Integrations → Keys
# Download the .p8 file, note the Key ID and Issuer ID.
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Option B: Apple ID + app-specific password
# Create app-specific password at: appleid.apple.com → Sign-In and Security → App-Specific Passwords
# APPLE_ID=aasim.ss@gmail.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
